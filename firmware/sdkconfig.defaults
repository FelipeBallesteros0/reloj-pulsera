# ---- Chip y flash (Waveshare ESP32-C6-Touch-AMOLED-2.06: 16 MB QIO, sin PSRAM) ----
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# Consola por el USB-Serial/JTAG nativo (es el único puerto que llega al USB-C)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- BSP de Waveshare ----
CONFIG_BSP_I2C_NUM=0
# Buffer de dibujo de LVGL: 410 x 40 x 2 bytes = 33 KB (el valor por defecto, 100 líneas, son 82 KB)

# ---- LVGL 9 ----
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

# ---- Bluetooth: NimBLE, solo periférico, 1 conexión, bonds en NVS ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# El cliente GATT (CTS, ANCS) va ligado al rol central en NimBLE: hay que dejarlo activo
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_EXT_ADV=n

# Táctil: el FT3168 ya viene alineado con el panel (verificado con traza de toques)
CONFIG_RELOJ_TACTIL_ESPEJO_Y=n
CONFIG_RELOJ_TACTIL_ESPEJO_X=n

# ---- WiFi para ANDIA (búferes mínimos para caber en RAM) y coexistencia con BLE ----
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# I2S: el ESP32-C6 solo tiene I2S0 (el BSP trae 1 por defecto)
CONFIG_BSP_I2S_NUM=0
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4320
# CONFIG_LWIP_IPV6 is not set
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=12
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12

# ---- TLS para wss:// (Cloudflare) con la RAM justa: búferes chicos y liberación tras el saludo ----
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=1024
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# TLS 1.3 con tickets de sesión + liberar la config tras el saludo dio lecturas -0x7100: TLS 1.2 y sin liberar
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_RSA=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Envíos de audio desde otra tarea sin pelear con el candado del lector del WebSocket
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=1000
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=20
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LV_FONT_MONTSERRAT_48=y
